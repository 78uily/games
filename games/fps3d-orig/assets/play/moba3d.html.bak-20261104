<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
<title>俯视战场 3D</title>
<style>
  :root {
    --ink: #efe6ff;
    --dim: #8f86b8;
    --gold: #ffd166;
    --panel: #141122;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; height: 100%; overflow: hidden; background: #0a0912;
    /* 关键：不禁用浏览器手势的话，拖摇杆会被识别成滚动，直接 pointercancel */
    touch-action: none;
    overscroll-behavior: none;
  }
  body {
    font-family: "Segoe UI", "Microsoft YaHei", system-ui, sans-serif;
    -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent;
  }
  #app { position: fixed; inset: 0; }
  canvas { display: block; }

  /* ---------- HUD ---------- */
  #hud { position: fixed; inset: 0; pointer-events: none; color: var(--ink); z-index: 12; }

  /* 左上：六边形等级徽章 + 经验 */
  .hud-tl { position: absolute; left: 20px; top: 18px; display: flex; align-items: center; gap: 11px; }
  .lvbadge {
    width: 42px; height: 46px; display: flex; align-items: center; justify-content: center;
    background: linear-gradient(180deg, #241d44, #151129);
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    font: 700 16px/1 "Consolas", monospace; color: #cfe4ff;
  }
  .lvwrap { display: flex; flex-direction: column; gap: 7px; }
  .xpbar { width: 148px; height: 4px; border-radius: 2px; background: rgba(255,255,255,.10); overflow: hidden; }
  .xpbar i { display: block; height: 100%; width: 0%; background: linear-gradient(90deg,#3f8fc4,#7fd7ff); transition: width .18s; }
  .xptext { font: 10px/1 "Consolas", monospace; color: var(--dim); letter-spacing: 1.5px; }

  /* 顶部中：时间 */
  .hud-tm { position: absolute; left: 50%; top: 14px; transform: translateX(-50%); text-align: center; }
  .hud-tm .num {
    font: 700 27px/1 "Consolas", monospace; color: #e8e0ff; letter-spacing: 1px;
    text-shadow: 0 2px 10px rgba(0,0,0,.55);
  }
  .hud-tm .lbl { margin-top: 5px; font: 10px/1 "Consolas", monospace; color: var(--dim); letter-spacing: 4px; }

  /* 右上：击杀 */
  .hud-kill { position: absolute; right: 20px; top: 16px; text-align: right; }
  .hud-kill .num { font: 700 19px/1 "Consolas", monospace; color: #efe6ff; }
  .hud-kill .lbl { margin-top: 5px; font: 10px/1 "Consolas", monospace; color: var(--dim); letter-spacing: 3px; }

  /* BOSS 血条 */
  .hud-boss {
    position: absolute; left: 50%; top: 86px; transform: translateX(-50%);
    width: min(420px, 56vw); text-align: center; transition: opacity .25s;
  }
  .hud-boss.hide { opacity: 0; }
  .bossname { font: 600 11px/1 "Consolas", monospace; letter-spacing: 4px; color: #f0a0b4; margin-bottom: 6px; }
  .bosshp {
    height: 8px; border-radius: 4px; background: rgba(10,8,18,.8);
    box-shadow: inset 0 0 0 1px rgba(200,90,120,.45); overflow: hidden;
  }
  .bosshp i { display: block; height: 100%; width: 100%; background: linear-gradient(90deg,#c25a72,#f0a0b4); transition: width .12s; }

  /* 底部：血量 */
  .hud-bottom { position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%); width: min(360px, 46vw); }
  .hpbar {
    position: relative; height: 13px; border-radius: 7px; overflow: hidden;
    background: rgba(10,8,18,.85); box-shadow: inset 0 0 0 1px rgba(120,100,200,.35);
  }
  .hpbar i { display: block; height: 100%; width: 100%; background: linear-gradient(90deg,#2f8fc4,#6fd0ff); transition: width .12s; }
  .hpbar.low i { background: linear-gradient(90deg,#c2405e,#ff8aa6); }
  .hptext {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font: 600 10px/1 "Consolas", monospace; color: rgba(255,255,255,.9); letter-spacing: 1.5px;
    text-shadow: 0 1px 2px rgba(0,0,0,.7);
  }

  /* 左下：已拿到的技能 */
  #skills { position: absolute; left: 20px; bottom: 24px; display: flex; gap: 6px; }
  #toys {
    position: absolute; left: 20px; bottom: 66px;
    font: 10px/1 "Consolas", monospace; color: #8f86b8; letter-spacing: 1.6px;
  }
  #toys b { color: #c9b6ff; font-weight: 600; }
  .skill-chip {
    width: 34px; height: 34px; border-radius: 8px; display: flex; align-items: center; justify-content: center;
    background: rgba(20,16,36,.88); border: 1px solid rgba(120,100,200,.45); color: #a99fd0;
  }
  .skill-chip[data-r="link"] { border-color: rgba(95,200,255,.7); color: #9fe4ff; }
  .skill-chip[data-r="evo"] { border-color: rgba(255,209,102,.85); color: #ffd166; }
  .skill-chip svg { width: 19px; height: 19px; }

  /* 右下：跳跃按钮（只在触屏出现） */
  #jumpBtn {
    position: absolute; right: 26px; bottom: 26px; width: 74px; height: 74px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(90,170,220,.34), rgba(20,16,36,.92));
    border: 1px solid rgba(120,180,230,.6); color: #cfe8ff;
    display: none; align-items: center; justify-content: center; pointer-events: auto;
    transition: opacity .12s, transform .1s;
  }
  #jumpBtn.show { display: flex; }
  #jumpBtn:active { transform: scale(.94); }
  #jumpBtn.cd { opacity: .32; }
  #jumpBtn svg { width: 30px; height: 30px; }

/* ---------- 覆盖层 ---------- */
  .overlay {
    position: fixed; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    background: rgba(7,6,12,.82); backdrop-filter: blur(2px);
    color: var(--ink); z-index: 20;
  }
  .overlay.hide { display: none; }
  .ptitle { font: 600 26px/1.2 system-ui, sans-serif; color: #ffe9a8; letter-spacing: 2px; }
  .psub { margin-top: 10px; font: 12px/1 "Consolas", monospace; color: var(--dim); letter-spacing: 1px; }
  #cards { display: flex; gap: 18px; margin-top: 30px; flex-wrap: wrap; justify-content: center; padding: 0 18px; }
  .card {
    position: relative; width: 212px; padding: 24px 18px 18px;
    background: linear-gradient(180deg, #1e1836, #151127);
    border: 1px solid #4b3f78; border-radius: 12px; cursor: pointer;
    transition: transform .14s, border-color .14s, box-shadow .14s;
    display: flex; flex-direction: column; align-items: center; gap: 11px;
    animation: cardIn .28s ease-out both;
  }
  .card:hover { transform: translateY(-4px); }
  .card .icon { width: 58px; height: 58px; display: flex; align-items: center; justify-content: center; color: #9fd8ff; }
  .card .icon svg { width: 46px; height: 46px; }
  .card .rar { font: 10px/1 "Consolas", monospace; letter-spacing: 3px; }
  .card .nm { font: 600 20px/1.2 system-ui, sans-serif; color: #efe6ff; letter-spacing: 1px; }
  .card .ds { font: 13px/1.55 system-ui, sans-serif; color: #a99fd0; text-align: center; min-height: 40px; }
  .card .key { position: absolute; right: 12px; top: 10px; font: 11px/1 "Consolas", monospace; color: #6f6796; }
  .card[data-r="base"] { border-color: #4b3f78; }
  .card[data-r="base"] .rar { color: #8f9fd0; }
  .card[data-r="link"] { border-color: #35678f; }
  .card[data-r="link"] .rar { color: #5fc8ff; }
  .card[data-r="link"] .icon { color: #5fc8ff; }
  .card[data-r="evo"] { border-color: #a8842f; background: linear-gradient(180deg, #2b2214, #1a1526); }
  .card[data-r="evo"] .rar { color: #ffd166; }
  .card[data-r="evo"] .icon { color: #ffd166; }
  .card:hover[data-r="base"] { border-color: #9c86e0; }
  .card:hover[data-r="link"] { border-color: #7fd7ff; }
  .card:hover[data-r="evo"] { border-color: #ffd166; box-shadow: 0 0 26px rgba(255,209,102,.16); }
  @keyframes cardIn { from { opacity: 0; transform: translateY(16px) } to { opacity: 1; transform: none } }

  #pause .ptitle { font-size: 28px; }
  #pause .psub { margin-top: 16px; }

  #over .box {
    width: min(420px, 86vw); padding: 28px 24px; border-radius: 12px;
    background: #120f1c; border: 1px solid #4b3f78; text-align: center;
  }
  #over .big { font: 600 26px/1.2 system-ui, sans-serif; color: #ffe9a8; }
  #over .line { margin-top: 14px; font: 14px/1.6 system-ui, sans-serif; color: #cbbff0; }
  #over .small { margin-top: 8px; font: 12px/1.6 "Consolas", monospace; color: var(--dim); }
  #over .again { margin-top: 20px; font: 12px/1 system-ui, sans-serif; color: #8f86b8; }

  /* ---------- 触屏摇杆 ---------- */
  #stick { position: fixed; inset: 0; z-index: 10; display: none; }
  #stick.on { display: block; }
  #stickBase {
    position: absolute; width: 118px; height: 118px; margin: -59px 0 0 -59px;
    border-radius: 50%; border: 1px solid rgba(155,134,224,.45);
    background: rgba(42,35,70,.45); display: none;
  }
  #stickKnob {
    position: absolute; width: 52px; height: 52px; margin: -26px 0 0 -26px;
    border-radius: 50%; background: rgba(122,102,180,.85); display: none;
  }

  /* ---------- 打击飘字 ---------- */
  #floaters { position: fixed; inset: 0; pointer-events: none; z-index: 8; overflow: hidden; }
  .float {
    position: absolute; transform: translate(-50%, -50%);
    font: 700 15px/1 "Consolas", monospace; color: #ffffff;
    text-shadow: 0 1px 3px rgba(0,0,0,.75);
    animation: floatUp .5s ease-out forwards; will-change: transform, opacity;
  }
  .float.kill { color: #8ef0c8; }
  .float.boss { color: #ffd166; font-size: 18px; }
  @keyframes floatUp {
    0%   { opacity: 1;   transform: translate(-50%, -50%) scale(1.2); }
    100% { opacity: 0;   transform: translate(-50%, -170%) scale(.86); }
  }

  /* 挨打时屏幕边缘泛红 */
  #dmgFlash {
    position: fixed; inset: 0; pointer-events: none; z-index: 9;
    box-shadow: inset 0 0 46px rgba(255,70,105,.28);
    opacity: 0; transition: opacity .16s ease-out;
  }

  /* 极限闪避：擦弹时边缘泛蓝 */
  #slowFlash {
    position: fixed; inset: 0; pointer-events: none; z-index: 9;
    box-shadow: inset 0 0 70px rgba(120,180,255,.30);
    opacity: 0; transition: opacity .12s ease-out;
  }

  /* 竖屏提示：3D 俯视在竖屏里视野太窄，直接让转屏 */
  #rotate {
    position: fixed; inset: 0; z-index: 60; display: none;
    align-items: center; justify-content: center; text-align: center;
    background: #0a0912; color: var(--dim);
    font: 14px/1.8 system-ui, sans-serif; padding: 24px;
  }
  #rotate b { display: block; font-size: 22px; color: var(--ink); margin-bottom: 10px; letter-spacing: 2px; }
  @media (orientation: portrait) {
    #rotate { display: flex; }
  }

  /* ==================== 主页 / 菜单：极简 ==================== */
  .screen {
    position: fixed; inset: 0; z-index: 40;
    display: flex; align-items: center; justify-content: center;
    background: #08070f;
    color: var(--ink);
    font-family: system-ui, "Microsoft YaHei", sans-serif;
  }
  .screen.hide { display: none; }
  /* 菜单要能看见暂停的游戏画面 */
  #menu { background: rgba(8,7,15,.82); }

  .home-inner { text-align: center; animation: fadeUp .5s ease-out both; }
  .home-mark {
    width: 10px; height: 10px; margin: 0 auto 30px;
    background: #6fc8ff;
    transform: rotate(45deg);
  }
  .home-title {
    margin: 0; font-size: 54px; font-weight: 300; letter-spacing: 20px;
    color: #f2ecff; text-indent: 20px;
  }
  .home-sub {
    margin-top: 16px; font-size: 13px; letter-spacing: 6px; color: #6f6796;
    text-indent: 6px;
  }
  .btn-main {
    margin-top: 52px; padding: 14px 54px;
    background: transparent; color: #cfe8ff;
    border: 1px solid rgba(111,200,255,.55); border-radius: 2px;
    font: 400 15px/1 system-ui, sans-serif; letter-spacing: 8px; text-indent: 8px;
    cursor: pointer; transition: border-color .18s, color .18s, background .18s;
  }
  .btn-main:hover { border-color: #6fc8ff; color: #fff; background: rgba(111,200,255,.06); }
  .home-keys {
    margin-top: 78px; font-size: 11px; letter-spacing: 2px; color: #4d4770;
  }

  .menu-inner {
    width: min(380px, 86vw); text-align: center;
    padding: 40px 36px 32px;
    background: rgba(10,9,18,.96);
    border: 1px solid rgba(120,100,200,.16);
  }
  .menu-title {
    font-size: 13px; letter-spacing: 12px; color: #6f6796; text-indent: 12px;
    margin-bottom: 40px;
  }
  .btn-line {
    display: block; width: 100%; margin: 10px 0; padding: 13px 0;
    background: transparent; color: #d8d0f0;
    border: 1px solid rgba(120,100,200,.32); border-radius: 2px;
    font: 400 14px/1 system-ui, sans-serif; letter-spacing: 5px; text-indent: 5px;
    cursor: pointer; transition: border-color .16s, color .16s;
  }
  .btn-line:hover { border-color: rgba(140,190,255,.75); color: #fff; }

  .menu-row {
    display: flex; align-items: center; gap: 14px;
    margin: 26px 0 22px; padding: 0 2px;
  }
  .menu-label { font-size: 12px; letter-spacing: 3px; color: #6f6796; }
  .menu-val {
    width: 30px; text-align: right;
    font: 400 12px/1 "Consolas", monospace; color: #8f86b8;
  }
  input[type="range"] {
    -webkit-appearance: none; appearance: none;
    flex: 1; height: 2px; background: rgba(120,100,200,.35);
    outline: none; cursor: pointer;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 11px; height: 11px; border-radius: 50%;
    background: #8fc8f0; border: none;
  }
  input[type="range"]::-moz-range-thumb {
    width: 11px; height: 11px; border-radius: 50%; background: #8fc8f0; border: none;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
</style>
</head>
<body>
<div id="app"></div>

<div id="hud">
  <div class="hud-tl">
    <div class="lvbadge" id="lv">1</div>
    <div class="lvwrap">
      <div class="xpbar"><i id="xpfill"></i></div>
      <div class="xptext" id="xptext">成长 0%</div>
    </div>
  </div>

  <div class="hud-tm">
    <div class="num" id="clock">180.0</div>
    <div class="lbl">剩余</div>
  </div>

  <div class="hud-kill">
    <div class="num" id="kills">0</div>
    <div class="lbl">击杀</div>
  </div>

  <div class="hud-boss hide" id="bossbar">
    <div class="bossname">BOSS</div>
    <div class="bosshp"><i id="bosshpfill"></i></div>
  </div>

  <div class="hud-bottom">
    <div class="hpbar" id="hpbar">
      <i id="hpfill"></i>
      <div class="hptext" id="hptext">100 / 100</div>
    </div>
  </div>

  <div id="toys"></div>
  <div id="skills"></div>

  <div id="jumpBtn" title="跳跃">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 20V6"></path><path d="M6.5 11.5L12 5.5l5.5 6"></path>
    </svg>
  </div>
</div>

<div id="stick"><div id="stickBase"></div><div id="stickKnob"></div></div>
<div id="floaters"></div>
<div id="dmgFlash"></div>
<div id="slowFlash"></div>
<div id="rotate"><div><b>请横过来玩</b>竖屏视野太窄，转成横屏再进</div></div>

<div class="overlay hide" id="panel">
  <div class="ptitle">选择一项强化</div>
  <div class="psub" id="pickno">第 1 次 · 点卡片 或 按 1 / 2 / 3</div>
  <div id="cards"></div>
</div>

<div class="overlay hide" id="pause">
  <div class="ptitle">已暂停</div>
  <div class="psub">按 P 继续</div>
</div>

<!-- 主页 -->
<div class="screen" id="home">
  <div class="home-inner">
    <div class="home-mark"></div>
    <h1 class="home-title">俯视战场</h1>
    <div class="home-sub">三分钟一局 · 巨爽巨解压</div>
    <button class="btn-main" id="startBtn">开始</button>
    <div class="home-keys">WASD 移动 · 空格跳跃 · ESC 菜单</div>
  </div>
</div>

<!-- ESC 菜单 -->
<div class="screen hide" id="menu">
  <div class="menu-inner">
    <div class="menu-title">暂停</div>
    <button class="btn-line" id="resumeBtn">继续</button>
    <div class="menu-row">
      <span class="menu-label">音效</span>
      <input type="range" id="volRange" min="0" max="100" value="70" />
      <span class="menu-val" id="volVal">70</span>
    </div>
    <button class="btn-line" id="homeBtn">返回主页</button>
  </div>
</div>

<div class="overlay hide" id="over">
  <div class="box">
    <div class="big" id="overTitle">撑住了 3 分钟</div>
    <div class="line" id="overLine"></div>
    <div class="small" id="overSkills"></div>
    <div class="again" id="overAgain">点击 / 空格 再战</div>
  </div>
</div>

<script src="three.min.js"></script>
<script>
/* =========================================================
   俯视战场 3D —— 王者式固定俯角 + 抽象几何
   ========================================================= */

const IS_TOUCH = "ontouchstart" in window || navigator.maxTouchPoints > 0;
const RUN_TIME = 180;
const ARENA = 17;                  // 活动半径
const PICK_AT = [30, 60, 90, 120, 150];
const BOSS_WAVES = [90, 150];      // 每波两只

/* 相机：固定俯角，只跟随平移，永不旋转 */
const CAM = { fov: 45, height: 19, back: 13, lookAhead: 1.8, lookY: 0.8 };

const C = {
  bg: 0x0a0912,
  ground: 0x16122a,
  tileA: 0x201a3e,
  tileB: 0x241d45,
  hero: 0x6fc8ff,
  heroDark: 0x2b6d92,
  mobHex: 0xa45656,
  mobSq: 0xa3834a,
  mobTri: 0x7d70b0,
  boss: 0xa8465e,
  bossDark: 0x6b2a3b
};

/* ---------------- 音效（现场合成） ---------------- */
const SFX = {
  ctx: null,
  volume: 0.7,
  init() {
    if (this.ctx) return;
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return;
    this.ctx = new AC();
    this.master = this.ctx.createGain();
    this.master.gain.value = 0.42 * this.volume;
    this.master.connect(this.ctx.destination);
  },
  setVolume(v) {
    this.volume = Math.max(0, Math.min(1, v));
    if (this.master) this.master.gain.value = 0.42 * this.volume;
  },
  tone(f1, f2, dur, type, vol) {
    if (!this.ctx) return;
    const t = this.ctx.currentTime, o = this.ctx.createOscillator(), g = this.ctx.createGain();
    o.type = type || "sine";
    o.frequency.setValueAtTime(f1, t);
    if (f2) o.frequency.exponentialRampToValueAtTime(Math.max(1, f2), t + dur);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(vol || 0.2, t + 0.008);
    g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
    o.connect(g); g.connect(this.master);
    o.start(t); o.stop(t + dur + 0.02);
  },
  noise(dur, vol, hp) {
    if (!this.ctx) return;
    const t = this.ctx.currentTime;
    const len = Math.floor(this.ctx.sampleRate * dur);
    const buf = this.ctx.createBuffer(1, len, this.ctx.sampleRate);
    const d = buf.getChannelData(0);
    for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
    const src = this.ctx.createBufferSource(); src.buffer = buf;
    const f = this.ctx.createBiquadFilter(); f.type = hp ? "highpass" : "lowpass"; f.frequency.value = hp ? 1100 : 650;
    const g = this.ctx.createGain(); g.gain.value = vol || 0.12;
    src.connect(f); f.connect(g); g.connect(this.master); src.start(t);
  },
  hit() { this.noise(0.035, 0.05, true); this.tone(1500, 950, 0.045, "triangle", 0.055); this.tone(220, 140, 0.05, "square", 0.03); },
  kill() { this.noise(0.09, 0.075, false); this.tone(430, 88, 0.13, "triangle", 0.115); this.tone(1200, 700, 0.05, "sine", 0.04); },
  hurt() { this.tone(150, 55, 0.2, "sawtooth", 0.14); },
  level() { this.tone(520, 0, 0.09, "sine", 0.14); setTimeout(() => this.tone(780, 0, 0.14, "sine", 0.12), 80); },
  pick() { this.tone(640, 900, 0.11, "sine", 0.13); },
  boss() { this.tone(96, 56, 0.4, "sawtooth", 0.13); setTimeout(() => this.tone(70, 46, 0.5, "sawtooth", 0.09), 170); },
  bossDown() { this.tone(230, 70, 0.38, "triangle", 0.15); this.noise(0.28, 0.09, false); },
  shot() { this.tone(700, 480, 0.045, "triangle", 0.035); },
  jump() { this.tone(420, 760, 0.13, "sine", 0.1); },
  slam() { this.tone(135, 40, 0.36, "sawtooth", 0.18); this.noise(0.3, 0.14, false); this.tone(900, 260, 0.07, "triangle", 0.07); },
  ebolt() { this.tone(300, 180, 0.1, "square", 0.05); },
  bounce() { this.tone(880, 1320, 0.07, "triangle", 0.06); }
};

